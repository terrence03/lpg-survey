<?xml version="1.0" encoding="utf-8"?>
<!--
  放在 IIS 應用程式 /lpg-survey 的實體資料夾內（資料夾裡只要這個檔案）。
  需要先安裝 URL Rewrite 與 Application Request Routing (ARR)，並在 ARR 啟用 Proxy。
  所有請求轉給本機 127.0.0.1:8538 的 uvicorn 服務，/lpg-survey 前綴會被去掉。
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="lpg-survey to uvicorn" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8538/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
